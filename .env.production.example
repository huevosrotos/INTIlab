# ============================================================
# DrogLab — Variables de entorno de producción
# ============================================================
# Copiar a .env y ajustar según el entorno.

# Base de datos
# SQLite (por defecto, archivo local):
DATABASE_URL=file:/app/db/custom.db

# MariaDB/MySQL (para migrar en el futuro):
# DATABASE_URL=mysql://droglab:droglab@db:3306/droglab
# DATABASE_URL=mysql://admin:inti1957@192.168.2.205:3306/droglab

# Si se cambia a MariaDB, también cambiar en prisma/schema.prisma:
#   datasource db { provider = "mysql" }  (en vez de "sqlite")

# Entorno
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Token del endpoint /api/setup (para inicializar la DB)
# Cambiar en producción real o eliminar el endpoint.
SETUP_TOKEN=droglab-setup-2024
