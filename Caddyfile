# ============================================================
# DrogLab — Configuración de Caddy (reverse proxy + HTTPS)
# ============================================================
# Caddy gestiona certificados automáticamente. Para IPs locales
# usa un certificado autofirmado (tls internal). Para dominios
# públicos obtiene certificados Let's Encrypt automáticamente.
#
# IMPORTANTE: Cambiar la IP abajo por la IP real del host donde
# corre Docker. Si accedés desde otra IP, agregarla también.
# ============================================================

# Escuchar en el puerto 443 (HTTPS) para cualquier host.
# tls internal genera un certificado autofirmado on-demand para
# cualquier IP o hostname que se use para acceder (192.168.2.63,
# localhost, etc.). El navegador va a mostrar advertencia la primera
# vez — aceptar el riesgo para continuar.
:443 {
    tls internal {
        on_demand
    }
    reverse_proxy droglab:3000
}

# Puerto 80 (HTTP) — acceso directo sin HTTPS para casos donde no
# se necesite la cámara (escáner QR, fotos).
:80 {
    reverse_proxy droglab:3000
}

# Para acceso por dominio público (Let's Encrypt automático):
# Descomentar y cambiar 'droglab.tudominio.com':
#
# droglab.tudominio.com {
#     reverse_proxy droglab:3000
#     # tls automático (no hace falta tls internal)
# }
