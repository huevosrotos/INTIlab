// DrogLab - Sistema de gestión de droguero de laboratorio químico

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  role         String   @default("OPERARIO") // ADMIN | ENCARGADO | OPERARIO | AUDITOR
  active       Boolean  @default(true)
  warehouseId  String?
  warehouse    Warehouse? @relation("WarehouseMembers", fields: [warehouseId], references: [id])
  responsibleOf Warehouse? @relation("WarehouseResponsible")
  movements    Movement[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Warehouse {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  type         String   // PRINCIPAL | SECUNDARIO
  location     String?
  description  String?
  active       Boolean  @default(true)
  responsibleId String? @unique
  responsible  User?    @relation("WarehouseResponsible", fields: [responsibleId], references: [id])
  members      User[]   @relation("WarehouseMembers")
  lots         Lot[]
  movementsFrom Movement[] @relation("MovementFrom")
  movementsTo   Movement[] @relation("MovementTo")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Drug {
  id                 String   @id @default(cuid())
  code               String?  @unique // código nuevo: TIPO-ARMARIO-ESTANTE-CORR (ej: IND-A1-001)
  chemicalName       String
  commercialName     String?
  cas                String?  @unique
  formula            String?
  molecularWeight    Float?
  purity             String?
  physicalState      String?  // SOLIDO | LIQUIDO | GAS | OTRO
  hazardClass        String?
  pictograms         String   @default("[]") // JSON array string of GHS pictogram keys
  hStatements        String?  // JSON array string
  chemicalClasses    String   @default("[]") // JSON array string of chemical class keys (INORGANICO, ACIDO, etc.)
  defaultWarehouseId String?
  defaultLocation    String?  // armario-estante predeterminado
  minStock           Float?   @default(0)
  unit               String?  // g, mL, kg, L, u
  sdsUrl             String?
  notes              String?
  active             Boolean  @default(true)
  lots               Lot[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Lot {
  id              String   @id @default(cuid())
  drugId          String
  drug            Drug     @relation(fields: [drugId], references: [id])
  lotNumber       String
  qrCode          String   @unique
  expiryDate      DateTime?
  supplier        String?
  purchaseDate    DateTime?
  initialQuantity Float
  currentQuantity Float
  unit            String
  warehouseId     String?
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  location        String?
  purity          String?  // pureza del lote (ej: "≥99,5%"); si es null usa el de la droga
  notes           String?  // observaciones del lote (ej: "húmedo", "prestado", "contaminado")
  containerPhoto  String?
  labelPhoto      String?
  status          String   @default("ACTIVO") // ACTIVO | EN_USO | CONSUMIDO | VENCIDO | DADO_DE_BAJA
  // Fechas de trazabilidad del ciclo de vida del frasco
  receivedDate    DateTime? // fecha de recibido (ingreso al sistema)
  openedDate      DateTime? // fecha de apertura del frasco (habilitación para uso)
  consumedDate    DateTime? // fecha de consumo (frasco totalmente consumido)
  discardedDate   DateTime? // fecha de baja (descarte/derrame)
  movements       Movement[]
  alerts          Alert[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([drugId])
  @@index([warehouseId])
}

model Movement {
  id              String   @id @default(cuid())
  lotId           String
  lot             Lot      @relation(fields: [lotId], references: [id])
  type            String   // INGRESO | TRANSFERENCIA | CONSUMO | DEVOLUCION | BAJA | AJUSTE
  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse? @relation("MovementTo", fields: [toWarehouseId], references: [id])
  quantity        Float
  balanceAfter    Float?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  reason          String?
  createdAt       DateTime @default(now())

  @@index([lotId])
  @@index([createdAt])
}

model Alert {
  id        String   @id @default(cuid())
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id])
  type      String   // VENCIMIENTO | STOCK_BAJO | STOCK_AGOTADO
  severity  String   // INFO | WARNING | CRITICAL
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([lotId])
  @@index([resolved])
}
